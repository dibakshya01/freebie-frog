{
  "server": {
    "addr": "127.0.0.1:4000",
    "read_timeout": "30s",
    "write_timeout": "0s",
    "shutdown_timeout": "15s"
  },
  "log": {
    "level": "info",
    "format": "text"
  },
  "providers": {
    "groq": {
      "type": "openai",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_ref": "env:GROQ_API_KEY",
      "models": ["llama-3.3-70b-versatile", "llama-3.1-8b-instant"]
    },
    "openrouter": {
      "type": "openai",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_ref": "env:OPENROUTER_API_KEY",
      "models": ["deepseek/deepseek-chat-v3:free"]
    },
    "ollama": {
      "type": "openai",
      "base_url": "http://localhost:11434/v1",
      "allow_local": true,
      "models": ["qwen2.5-coder:7b"]
    }
  },
  "models": {
    "default": ["groq/llama-3.3-70b-versatile", "openrouter/deepseek/deepseek-chat-v3:free", "ollama/qwen2.5-coder:7b"],
    "tiers": {
      "haiku": ["groq/llama-3.1-8b-instant", "ollama/qwen2.5-coder:7b"]
    }
  }
}
